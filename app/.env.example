# Скопировать в .env и вставить свой ключ (openrouter.ai → Keys → Create Key).
# Ключ секретный: .env в git не попадает.
VITE_OPENROUTER_API_KEY=
# openrouter/free — роутер: сам выбирает свободную модель из бесплатных.
# Можно указать конкретную, например google/gemma-4-31b-it:free
# или платную DeepSeek: deepseek/deepseek-chat
VITE_LLM_MODEL=openrouter/free
# Адрес API: по умолчанию OpenRouter. Прямой DeepSeek API (ключ с platform.deepseek.com):
# VITE_LLM_API_URL=https://api.deepseek.com/chat/completions
# ВАЖНО: любой VITE_* ключ вшивается в клиентский бандл и виден посетителю —
# платный ключ держи с лимитом расходов или через серверный прокси
# (подробности — в LLM-ключ-и-модель.md в корне проекта).
